<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>InPerson_Location_Required</fullName>
    <active>true</active>
    <description>In-person events require a location.</description>
    <errorConditionFormula>ISPICKVAL(EventType__c, "In-Person") &amp;&amp; ISBLANK(Location__c)</errorConditionFormula>
    <errorDisplayField>Location__c</errorDisplayField>
    <errorMessage>In-person events require a location. Please select a location.</errorMessage>
</ValidationRule>
